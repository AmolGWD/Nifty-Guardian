# --------------------------------------
# Secrets - never commit these
# --------------------------------------
.env
.env.*
!.env.example
kite_token.json
*.pem
*.key

# --------------------------------------
# Python
# --------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --------------------------------------
# Node / Frontend
# --------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# --------------------------------------
# Runtime data
# --------------------------------------
# Anchored to the repo-root-relative runtime SQLite directory only -
# an unanchored `data/` would also match (and silently swallow)
# source packages like backend/app/data/ and backend/tests/data/.
/backend/data/
*.db
*.sqlite3

# --------------------------------------
# OS / Editor
# --------------------------------------
.DS_Store
*.log
