# NIFTY Guardian v2 - Development environment configuration.
#
# Copy this file to config/development.env and adjust as needed:
#   cp config/development.env.example config/development.env
#
# config/development.env is gitignored - never commit it, even for
# local development. See docs/CONFIGURATION_REFERENCE.md for a full
# reference of every variable below, and docs/SECURITY.md for secret
# management guidance.

# ---------------------------------------------------------------
# Core application (app.core.config.Settings)
# ---------------------------------------------------------------

APP_NAME=NIFTY Guardian v2
# One of: development | staging | production
ENVIRONMENT=development
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
# One of: text | json - "text" is easiest to read in a local terminal
LOG_FORMAT=text

HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# SQLAlchemy connection string. Default is a local SQLite file.
DATABASE_URL=sqlite:///./data/nifty_guardian.db

# Required - a Fernet key used to encrypt secrets (e.g. Kite access
# tokens) at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The value below is a fixed, published dev-only key - never reuse it
# outside local development, and never use it in staging/production.
SECRET_KEY=3z3sD1v3zK7f3F1v3F7f3F1v3F7f3F1v3F7f3F1v3F0=

# Zerodha Kite Connect OAuth login flow (app.kite - human browser login,
# separate from the Zerodha Broker Adapter below). Leave blank if you
# aren't testing Kite login locally.
KITE_API_KEY=
KITE_API_SECRET=

# NSE market session hours (HH:MM)
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# ---------------------------------------------------------------
# Zerodha Broker Adapter (app.brokers.authentication.ZerodhaCredentials)
# ---------------------------------------------------------------
# Independent of KITE_API_KEY/KITE_API_SECRET above - this is an
# already-generated access token for automated broker connectivity,
# not an interactive login. Leave blank unless you are exercising
# app.brokers against a real (or sandboxed) Kite Connect account.

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_BASE_URL=
# Honestly documented as unused - Kite Connect has no refresh-token
# mechanism. Present only because the original CTO brief named it.
ZERODHA_REFRESH_TOKEN=

# ---------------------------------------------------------------
# Live Trading Mode (app.live.models.LiveConfig)
# ---------------------------------------------------------------
# LIVE_MODE=false is the only safe default for local development.

LIVE_MODE=false
MAX_DAILY_LOSS=10000.0
MAX_OPEN_POSITIONS=1
MAX_ORDERS_PER_DAY=10
# NOTE: the actual field is heartbeat_interval_seconds, so pydantic-settings
# reads HEARTBEAT_INTERVAL_SECONDS, not HEARTBEAT_INTERVAL as the original
# Phase 24 brief named it - documented here as the real, working variable.
HEARTBEAT_INTERVAL_SECONDS=5.0
RECONNECT_LIMIT=5
TRADING_START=09:15
TRADING_END=15:30

# ---------------------------------------------------------------
# Frontend (frontend/.env - Vite reads these at build time)
# ---------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
# One of: mock | rest
VITE_DASHBOARD_SERVICE=mock
VITE_DASHBOARD_POLLING_INTERVAL_MS=1000
VITE_API_TIMEOUT_MS=5000
# One of: 1x | 2x | 5x | 10x | Unlimited
VITE_DEFAULT_REPLAY_SPEED=1x
