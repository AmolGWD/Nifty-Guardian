# NIFTY Guardian v2 - Staging environment configuration.
#
# Copy this file to config/staging.env and fill in every value marked
# CHANGE ME:
#   cp config/staging.env.example config/staging.env
#
# config/staging.env is gitignored - never commit it. See
# docs/CONFIGURATION_REFERENCE.md for a full reference of every
# variable below, and docs/SECURITY.md for secret management guidance.
# Staging exists to catch what local development can't - a real
# reverse proxy, a real domain, a real (but non-production) database -
# so treat its secrets with the same care as production's, not
# development's.

# ---------------------------------------------------------------
# Core application (app.core.config.Settings)
# ---------------------------------------------------------------

APP_NAME=NIFTY Guardian v2 (Staging)
ENVIRONMENT=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

HOST=0.0.0.0
PORT=8000

# The staging frontend's real origin - never localhost
CORS_ORIGINS=https://staging.CHANGE-ME.example.com

# A staging-only database, never shared with production
DATABASE_URL=sqlite:////data/nifty_guardian_staging.db

# Generate a fresh key for staging - never reuse development's or
# production's:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE-ME-generate-a-fresh-fernet-key

KITE_API_KEY=CHANGE-ME
KITE_API_SECRET=CHANGE-ME

MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# ---------------------------------------------------------------
# Zerodha Broker Adapter (app.brokers.authentication.ZerodhaCredentials)
# ---------------------------------------------------------------
# Leave blank unless staging is specifically exercising real broker
# connectivity - most staging runs don't need this set at all.

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_BASE_URL=
ZERODHA_REFRESH_TOKEN=

# ---------------------------------------------------------------
# Live Trading Mode (app.live.models.LiveConfig)
# ---------------------------------------------------------------
# LIVE_MODE must stay false in staging - staging exists to validate
# deployment mechanics, not to place real orders.

LIVE_MODE=false
MAX_DAILY_LOSS=10000.0
MAX_OPEN_POSITIONS=1
MAX_ORDERS_PER_DAY=10
HEARTBEAT_INTERVAL_SECONDS=5.0
RECONNECT_LIMIT=5
TRADING_START=09:15
TRADING_END=15:30

# ---------------------------------------------------------------
# Frontend (frontend/.env - Vite reads these at build time)
# ---------------------------------------------------------------

VITE_API_BASE_URL=https://staging-api.CHANGE-ME.example.com
VITE_DASHBOARD_SERVICE=rest
VITE_DASHBOARD_POLLING_INTERVAL_MS=1000
VITE_API_TIMEOUT_MS=5000
VITE_DEFAULT_REPLAY_SPEED=1x
