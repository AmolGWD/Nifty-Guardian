# NIFTY Guardian v2 - Production environment configuration.
#
# Copy this file to config/production.env and fill in every value
# marked CHANGE ME:
#   cp config/production.env.example config/production.env
#
# config/production.env is gitignored and must NEVER be committed. See
# docs/CONFIGURATION_REFERENCE.md for a full reference of every
# variable below, docs/SECURITY.md for secret management guidance, and
# docs/RELEASE_CHECKLIST.md before the first production deployment.

# ---------------------------------------------------------------
# Core application (app.core.config.Settings)
# ---------------------------------------------------------------

APP_NAME=NIFTY Guardian v2
ENVIRONMENT=production
# INFO or higher - never DEBUG in production (app.observability.startup
# flags this at startup if misconfigured)
LOG_LEVEL=INFO
LOG_FORMAT=json

HOST=0.0.0.0
PORT=8000

# The real production frontend origin(s), comma-separated - never
# localhost (app.observability.startup flags this too)
CORS_ORIGINS=https://CHANGE-ME.example.com

# A real, persistent, backed-up database location - see
# docs/OPERATIONS_RUNBOOK.md's Backup section
DATABASE_URL=CHANGE-ME

# Required. Generate a fresh key - never reuse development's or
# staging's, and never commit it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE-ME-generate-a-fresh-fernet-key

KITE_API_KEY=CHANGE-ME
KITE_API_SECRET=CHANGE-ME

MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# ---------------------------------------------------------------
# Zerodha Broker Adapter (app.brokers.authentication.ZerodhaCredentials)
# ---------------------------------------------------------------
# Required only if LIVE_MODE=true below. ZERODHA_ACCESS_TOKEN expires
# daily and Kite Connect has no refresh mechanism - see
# docs/ZERODHA_ADAPTER_GUIDE.md and docs/OPERATIONS_RUNBOOK.md for the
# daily token-refresh procedure this implies.

ZERODHA_API_KEY=CHANGE-ME
ZERODHA_API_SECRET=CHANGE-ME
ZERODHA_ACCESS_TOKEN=CHANGE-ME
ZERODHA_BASE_URL=
# Honestly documented as unused - Kite Connect has no refresh-token
# mechanism. Present only because the original CTO brief named it.
ZERODHA_REFRESH_TOKEN=

# ---------------------------------------------------------------
# Live Trading Mode (app.live.models.LiveConfig)
# ---------------------------------------------------------------
# LIVE_MODE=false is the safe default. Only flip this to true once
# every item in docs/RELEASE_CHECKLIST.md's Live Trading section is
# checked, and every value below has been deliberately reviewed - see
# docs/LIVE_TRADING_GUIDE.md's Operational Checklist.

LIVE_MODE=false
MAX_DAILY_LOSS=CHANGE-ME
MAX_OPEN_POSITIONS=CHANGE-ME
MAX_ORDERS_PER_DAY=CHANGE-ME
# NOTE: the actual field is heartbeat_interval_seconds, so pydantic-settings
# reads HEARTBEAT_INTERVAL_SECONDS, not HEARTBEAT_INTERVAL as the original
# Phase 24 brief named it - documented here as the real, working variable.
HEARTBEAT_INTERVAL_SECONDS=5.0
RECONNECT_LIMIT=5
TRADING_START=09:15
TRADING_END=15:30

# ---------------------------------------------------------------
# Deployment metadata (app.observability.diagnostics)
# ---------------------------------------------------------------
# Optional - populated automatically by CI in deploy/docker/backend.Dockerfile
# builds when set as a build arg; safe to leave unset otherwise.

GIT_COMMIT=
APP_VERSION=2.0.0

# ---------------------------------------------------------------
# Frontend (frontend/.env - Vite reads these at BUILD time, not
# runtime - rebuild the frontend image after changing any of these)
# ---------------------------------------------------------------

VITE_API_BASE_URL=https://CHANGE-ME.example.com
VITE_DASHBOARD_SERVICE=rest
VITE_DASHBOARD_POLLING_INTERVAL_MS=1000
VITE_API_TIMEOUT_MS=5000
VITE_DEFAULT_REPLAY_SPEED=1x
