VITE_API_BASE_URL=http://localhost:8000

# Which DashboardService implementation the dashboard runs against -
# "mock" (default, no backend required) or "rest" (Phase 22 backend
# connectivity layer). See docs/DASHBOARD_GUIDE.md/docs/API_GUIDE.md.
VITE_DASHBOARD_SERVICE=mock

# How often the REST service polls GET /api/dashboard, in milliseconds.
VITE_DASHBOARD_POLLING_INTERVAL_MS=1000

# How long the REST service waits for any single request before treating
# it as a timeout, in milliseconds.
VITE_API_TIMEOUT_MS=5000

# Replay speed sent with POST /api/runtime/replay when the UI doesn't
# specify one explicitly - one of 1x/2x/5x/10x/Unlimited.
VITE_DEFAULT_REPLAY_SPEED=1x
